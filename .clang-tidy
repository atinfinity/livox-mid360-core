# clang-tidy configuration shared with livox-mid360-ros2 (issue #17).
# Style-only and known-false-positive checks are disabled; everything else is blocking in CI.
# modernize-use-ranges is off because Apple libc++ (macOS dev builds) lacks ranges algorithms;
# owning-memory needs GSL; pro-type-vararg flags POSIX fcntl(). Omitting trailing members in
# designated initializers is intentional and accepted by the -Werror builds.
# readability-braces-around-statements is on because the ROS 2 style requires braces on every
# if / for / while body (issue #63).
Checks: >
  bugprone-*,
  performance-*,
  modernize-*,
  readability-*,
  cppcoreguidelines-*,
  -bugprone-easily-swappable-parameters,
  -clang-diagnostic-missing-designated-field-initializers,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-vararg,
  -modernize-avoid-c-arrays,
  -modernize-use-designated-initializers,
  -modernize-use-ranges,
  -modernize-use-trailing-return-type,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-math-missing-parentheses,
  -readability-uppercase-literal-suffix
WarningsAsErrors: '*'
HeaderFilterRegex: '(include/livox/mid360/|src/session_detail\.hpp|tests/sim_process\.hpp)'
FormatStyle: file
CheckOptions:
  readability-implicit-bool-conversion.AllowPointerConditions: true
  readability-implicit-bool-conversion.AllowIntegerConditions: true
